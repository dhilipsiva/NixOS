record("Codex-2026-10-18-NixOS-windows-7", "{\"id\":\"Codex-2026-10-18-NixOS-windows-7\",\"speaker\":\"Codex\",\"text\":\"The VM exposed a pre-login issue: `pkexec` rejects the greeter’s inherited `nologin` shell. I’ve adjusted the button command to clear that variable and strengthened the test to require proof that the helper actually ran.\",\"kind\":\"message\",\"timestamp\":\"2026-10-18T18:09:20Z\",\"host\":\"dhilipsiva-desktop\",\"source\":\"codex\",\"session\":\"Codex-2026-10-18-NixOS-windows\",\"channel\":\"commentary\",\"about\":[\"nixos\",\"windows\"],\"private\":false,\"from\":null,\"kr\":null}", Message, Json).
