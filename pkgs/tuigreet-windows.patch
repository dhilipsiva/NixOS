+  #[tokio::test]
+  async fn windows_button_requires_confirmation() {
+    let (sender, mut receiver) = tokio::sync::mpsc::channel(4);
+    let mut state = Greeter::default();
+    state.mode = Mode::Username;
+    state.events = Some(sender);
+    state.powers.options.push(Power {
+      action: PowerOption::Windows,
+      label: "Reboot to Windows".to_string(),
+      command: Some("/test/reboot-to-windows".to_string()),
+    });
+    let greeter = Arc::new(RwLock::new(state));
+    handle(greeter.clone(), KeyEvent::new(KeyCode::F(11), KeyModifiers::NONE), Ipc::new()).await.unwrap();
+    assert_eq!(greeter.read().await.mode, Mode::Power);
+    assert!(receiver.try_recv().is_err());
+    handle(greeter.clone(), KeyEvent::new(KeyCode::Esc, KeyModifiers::NONE), Ipc::new()).await.unwrap();
+    assert_eq!(greeter.read().await.mode, Mode::Username);
+    assert!(receiver.try_recv().is_err());
+    handle(greeter.clone(), KeyEvent::new(KeyCode::F(11), KeyModifiers::NONE), Ipc::new()).await.unwrap();
+    handle(greeter.clone(), KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE), Ipc::new()).await.unwrap();
+    assert!(matches!(receiver.try_recv(), Ok(crate::event::Event::PowerCommand(_))));
+  }

