# Build outputs and tool caches
result
result-*
.direnv/
__pycache__/
*.py[cod]

# Local, per-machine Claude Code overrides (settings.json and hooks/ stay tracked)
.claude/settings.local.json
# Claude Code's per-session git worktrees; nixosctl needs a clean porcelain status
.claude/worktrees/

# Secrets hygiene: never commit private key material or decrypted output
*.agekey
*age*key*.txt
keys.txt
*.age.key
age-key*.txt
secrets/*.dec
secrets/*.decrypted
*.key
*.p12
*.pfx
.nixosctl/

# Local firmware troubleshooting photos
/images/

# Defense in depth: private Lucy memory belongs outside this Nix source tree.
# Git ignores do not exclude files from path-based Nix builds.
/lucy/private*
/lucy/.interactions.lock
